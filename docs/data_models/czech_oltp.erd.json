  "cards": [
    {
      "dot": "cyan",
      "title": "Postgres setup",
      "items": [
        "Add real primary keys. The Teradata script only sets a non-unique primary index on fin_loan, fin_order and fin_trans, and Debezium needs a key. All three IDs are unique in the data.",
        "Enforce the foreign keys; there are 0 orphans in the data.",
        "Set REPLICA IDENTITY FULL so updates and deletes capture the before-image."
      ]
    },
    {
      "dot": "amber",
      "title": "Two clocks",
      "items": [
        "trans_date is the business date from the source, with no time of day.",
        "recorded_at and the Debezium commit time are when the row actually reached Postgres."
      ]
    }
  ]
}