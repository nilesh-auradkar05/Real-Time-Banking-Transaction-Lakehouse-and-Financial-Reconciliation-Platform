  "cards": [
    {
      "dot": "amber",
      "title": "Profiled facts",
      "items": [
        "6,362,620 rows, 0 nulls, 743 hourly steps.",
        "8,213 fraud rows (0.13%), only in TRANSFER and CASH_OUT. 16 rows are flagged, all of them fraud.",
        "The source has no transaction ID, but step + type + origin + destination + amount is unique."
      ]
    },
    {
      "dot": "rose",
      "title": "Modelling limits",
      "items": [
        "Kaggle warns against using the balance columns for fraud detection: they are annulled when fraud is cancelled. Keep them in the fact, and exclude them from fraud features.",
        "Parties are columns, not a dimension. There are 9,073,900 distinct codes and no attributes beyond the C or M prefix.",
        "Merchant destinations have no balance data: both destination balances are 0 on all 2,151,495 rows."
      ]
    },
    {
      "dot": "cyan",
      "title": "Why it stays separate",
      "items": [
        "step is an hour offset with no calendar date, so it cannot join dim_date.",
        "amount is in an unnamed local currency and cannot be compared with Czech amounts.",
        "Everything here is synthetic, which the schema name states, so no data_origin column is needed."
      ]
    }
  ]
