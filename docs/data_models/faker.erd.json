  "cards": [
    {
      "dot": "rose",
      "title": "Keeping synthetic data separate",
      "items": [
        "Every Faker row has data_origin = faker_synthetic and a synthetic_batch_id. Every original row has czech_original and a null batch.",
        "Faker IDs start at 900,000,000. The highest original ID is 3,682,987. A CHECK constraint ties ID range, origin and batch together.",
        "Faker transactions post only to Faker accounts, so original balances and reconciliation results stay untouched."
      ]
    },
    {
      "dot": "cyan",
      "title": "Why a separate profile table",
      "items": [
        "The Czech data has no names or contact details. Names, emails and phones exist only for Faker clients, so original rows keep their source shape."
      ]
    },
    {
      "dot": "emerald",
      "title": "Reproducibility",
      "items": [
        "random_seed and generator versions on synthetic_batch let any batch be regenerated."
      ]
    }
  ]
