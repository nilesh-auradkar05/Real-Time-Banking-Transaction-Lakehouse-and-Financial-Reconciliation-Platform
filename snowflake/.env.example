# Copy to snowflake/.env (gitignored). Read by the Airflow containers, dbt (banking_dbt/profiles)
# and scripts/reconcile.py, so Snowflake credentials live in exactly one file.
SNOWFLAKE_ACCOUNT=orgname-accountname
SNOWFLAKE_USER=replace-me
SNOWFLAKE_PASSWORD=replace-me
SNOWFLAKE_ROLE=FINANCE_DBT_ROLE
SNOWFLAKE_WAREHOUSE=BANKING_ETL_WH

# Optional: run source-vs-warehouse reconciliation as the DAG's last task.
# Set only after exporting a snapshot (scripts/export_source_windows.py) with the source quiesced.
SOURCE_SNAPSHOT_ID=
RECON_WATERMARK_VERIFIED=false
